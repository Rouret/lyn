{
  "name": "@rouret/lyn",
  "version": "0.0.1",
  "description": "Type-safe APIs on Bun, without the setup.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#lyn/*": "./src/*.ts"
  },
  "bin": {
    "lyn": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.3.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "rouret",
    "url": "https://github.com/rouret"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rouret/lyn.git"
  },
  "homepage": "https://rouret.github.io/lyn/",
  "keywords": [
    "lyn",
    "framework",
    "backend",
    "typescript"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "bun --hot run testing/local.ts",
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "check:package": "bun run scripts/check-package.ts",
    "pack:example": "bun run scripts/pack-example.ts",
    "check:example": "bun run pack:example && bun run --cwd examples/feedback-board typecheck && bun run --cwd examples/feedback-board test",
    "deadcode": "knip",
    "test": "NODE_ENV=lyn-test bun test",
    "test:db": "docker compose up -d --wait postgres-test && NODE_ENV=lyn-test TEST_DATABASE_URL=postgres://lyn:lyn@localhost:54329/lyn_test bun test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^5.79.0",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "drizzle-kit": "^0.31.11"
  },
  "peerDependenciesMeta": {
    "drizzle-kit": {
      "optional": true
    }
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.4"
  }
}
