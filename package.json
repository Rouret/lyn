{
  "name": "@rouret/lyn",
  "module": "src/index.ts",
  "bin": {
    "lyn": "src/cli/index.ts"
  },
  "type": "module",
  "imports": {
    "#lyn/*": "./src/*.ts"
  },
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.3.6"
  },
  "author": {
    "name": "rouret",
    "url": "https://github.com/rouret"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rouret/lyn"
  },
  "homepage": "https://github.com/rouret/lyn",
  "keywords": [
    "lyn",
    "framework",
    "backend",
    "typescript"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "bun --hot run testing/local.ts",
    "build": "bun run scripts/build.ts",
    "deadcode": "knip",
    "test": "NODE_ENV=lyn-test bun test",
    "test:db": "docker compose up -d --wait postgres-test && NODE_ENV=lyn-test TEST_DATABASE_URL=postgres://lyn:lyn@localhost:54329/lyn_test bun test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^5.79.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "drizzle-kit": "^0.31.11"
  },
  "peerDependenciesMeta": {
    "drizzle-kit": {
      "optional": true
    }
  },
  "dependencies": {
    "better-auth": "^1.4.10",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.4"
  }
}
